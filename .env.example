# ============================================================
# AI 中医助手 Agent - 环境变量配置示例
# 复制为 .env 后修改
# ============================================================

# ---------- 阿里云百炼 (DashScope) ----------
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型（qwen3.8-max 原生多模态，统一文本/图片/结构化输出）
LLM_MODEL_NAME=qwen3.8-max

# ---------- 百炼知识库 ----------
KNOWLEDGE_BASE_GENERAL=your_general_kb_id
KNOWLEDGE_BASE_GENERAL_AGENT_ID=aid-your_agent_id
KNOWLEDGE_BASE_EXPERT=your_expert_kb_id
KNOWLEDGE_BASE_EXPERT_AGENT_ID=aid-your_agent_id
BAILIAN_WORKSPACE_ID=your_workspace_id

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=86400

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=aihoo_agent

# ---------- 应用 ----------
DEBUG=true
HOST=0.0.0.0
PORT=8000
